generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TrackingCounter {
  entity String @id
  value  Int    @default(0)
}

model Location {
  id        Int               @id @default(autoincrement())
  name      String
  region    String?
  latitude  Float
  longitude Float
  units     Unit[]
  problems  ProblemLocation[]
  projects  ProjectLocation[]
}

model Unit {
  id                 Int             @id @default(autoincrement())
  trackingId         String          @unique
  name               String          @unique
  abbreviation       String
  unitType           String
  parentOrganization String?
  locationId         Int?
  location           Location?       @relation(fields: [locationId], references: [id])
  leadProjects       Project[]       @relation("LeadUnit")
  projectLinks       ProjectUnit[]
  problemLinks       ProblemUnit[]
  capabilities       UnitTag[]
  lessons            LessonLearned[]
  activities         ActivityEvent[]
}

model Problem {
  id                  Int               @id @default(autoincrement())
  trackingId          String            @unique
  title               String
  shortDescription    String
  detailedDescription String
  problemStatement    String
  category            String
  priority            String
  status              String
  owner               String?
  visibility          String            @default("Internal")
  dateIdentified      DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  projectLinks        ProblemProject[]
  unitLinks           ProblemUnit[]
  tags                ProblemTag[]
  locations           ProblemLocation[]
  activities          ActivityEvent[]
}

model Project {
  id                     Int               @id @default(autoincrement())
  trackingId             String            @unique
  name                   String
  executiveSummary       String
  detailedDescription    String
  solutionApproach       String
  status                 String
  maturity               String
  completion             Int
  outcome                String?
  keyAdvantage           String?
  keyLimitation          String?
  latestResult           String?
  startDate              DateTime
  expectedCompletionDate DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  leadUnitId             Int
  leadUnit               Unit              @relation("LeadUnit", fields: [leadUnitId], references: [id])
  problemLinks           ProblemProject[]
  unitLinks              ProjectUnit[]
  tags                   ProjectTag[]
  locations              ProjectLocation[]
  phases                 ProjectPhase[]
  lessons                LessonLearned[]
  repositories           RepositoryLink[]
  activities             ActivityEvent[]
  helpRequests           HelpRequest[]
}

model ProblemProject {
  problemId Int
  projectId Int
  isPrimary Boolean @default(false)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([problemId, projectId])
}

model ProjectUnit {
  projectId Int
  unitId    Int
  role      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([projectId, unitId])
}

model ProblemUnit {
  problemId    Int
  unitId       Int
  relationship String
  problem      Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  unit         Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([problemId, unitId])
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  problems ProblemTag[]
  projects ProjectTag[]
  units    UnitTag[]
  lessons  LessonTag[]
}

model ProblemTag {
  problemId Int
  tagId     Int
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

model ProjectTag {
  projectId Int
  tagId     Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model UnitTag {
  unitId Int
  tagId  Int
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([unitId, tagId])
}

model LessonTag {
  lessonId Int
  tagId    Int
  lesson   LessonLearned @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tag      Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lessonId, tagId])
}

model ProblemLocation {
  problemId  Int
  locationId Int
  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([problemId, locationId])
}

model ProjectLocation {
  projectId  Int
  locationId Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([projectId, locationId])
}

model ProjectPhase {
  id               Int             @id @default(autoincrement())
  projectId        Int
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseName        String
  objective        String
  status           String
  completion       Int
  executiveSummary String
  technicalSummary String
  result           String?
  accomplishment   String?
  blocker          String?
  risk             String?
  nextAction       String?
  startedAt        DateTime?
  completedAt      DateTime?
  sortOrder        Int
  lessons          LessonLearned[]
}

model LessonLearned {
  id             Int           @id @default(autoincrement())
  trackingId     String        @unique
  title          String
  finding        String
  recommendation String
  date           DateTime
  projectId      Int
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId        Int?
  phase          ProjectPhase? @relation(fields: [phaseId], references: [id])
  unitId         Int?
  unit           Unit?         @relation(fields: [unitId], references: [id])
  tags           LessonTag[]
}

model RepositoryLink {
  id          Int     @id @default(autoincrement())
  projectId   Int
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  url         String
  description String
}

model ActivityEvent {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  eventType   String
  description String
  actor       String?
  problemId   Int?
  problem     Problem? @relation(fields: [problemId], references: [id])
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id])
  unitId      Int?
  unit        Unit?    @relation(fields: [unitId], references: [id])
}

model HelpRequest {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
}
